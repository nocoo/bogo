		"@tanstack/react-query": "^5.104.5",
		"@xyflow/react": "^12.12.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"js-yaml": "5.5.0",
		"lucide-react": "1.61.0",
		"marked": "18.1.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "8.5.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.0"
