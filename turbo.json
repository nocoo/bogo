{
	"$schema": "https://turbo.build/schema.json",
	"globalPassThroughEnv": [
		"BOGO_E2E_BASE",
		"BOGO_E2E_CONFIG",
		"BOGO_E2E_PERSIST",
		"BOGO_REQUIRE_CLI_E2E",
		"BOGO_SKIP_CLI_E2E",
		"BUN_CONFIG_REGISTRY",
		"NPM_CONFIG_REGISTRY"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"@bogo/ui#build": {
			"dependsOn": ["^build"],
			"outputs": ["../worker/static/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"test:unit:coverage": {
			"dependsOn": ["^build"]
		},
		"test:e2e": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
