# pre-commit: L1 on the Git index snapshot (UT/coverage, types, lint, routes, pages, staged secrets)
if [ -z "${BASH_VERSION-}" ]; then
	exec bash "$0" "$@"
fi
set -o pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/ensure-tools.sh
source "$HOOK_DIR/../scripts/ensure-tools.sh"

command -v git >/dev/null 2>&1 || {
	echo "pre-commit: git is required" >&2
	exit 1
}
command -v bun >/dev/null 2>&1 || {
	echo "pre-commit: bun is required" >&2
	exit 1
}
require_tool gitleaks "secrets scanning"

repo="$(git rev-parse --show-toplevel)"
snapshot=
TMPDIR_HOOK=

cleanup() {
	status=$?
	trap - EXIT INT TERM HUP
	if [ -n "$TMPDIR_HOOK" ]; then
		rm -rf "$TMPDIR_HOOK" || :
		TMPDIR_HOOK=
	fi
	if [ -n "$snapshot" ]; then
		rm -rf "$snapshot" || :
		snapshot=
	fi
	exit "$status"
}
trap cleanup EXIT
trap "exit 130" INT
trap "exit 143" TERM
trap "exit 129" HUP

# G2a: staged secrets are checked against the index before materialising the snapshot.
(
	cd "$repo" || exit 1
	gitleaks protect --staged --no-banner
)

snapshot=$(mktemp -d "${TMPDIR:-/tmp}/bogo-index-XXXXXX")
(
	cd "$repo" || exit 1
	git checkout-index --all --prefix="$snapshot/"
)

if [ ! -d "$repo/node_modules" ]; then
	echo "pre-commit: node_modules is required (run bun install --frozen-lockfile)" >&2
	exit 1
fi
if [ ! -f "$snapshot/package.json" ] || [ ! -f "$snapshot/bun.lock" ]; then
	echo "pre-commit: staged package.json and bun.lock are required" >&2
	exit 1
fi
if ! cmp -s "$snapshot/package.json" "$repo/package.json" || ! cmp -s "$snapshot/bun.lock" "$repo/bun.lock"; then
	echo "pre-commit: staged package.json/bun.lock must match the installed worktree copies" >&2
	exit 1
fi

wire_pkg_node_modules() {
	local consumer="$1" snap_nm repo_nm base entry ws wsname
	snap_nm="$snapshot/packages/$consumer/node_modules"
	repo_nm="$repo/packages/$consumer/node_modules"
	[ -d "$repo_nm" ] || return 0
	rm -rf "$snap_nm"
	mkdir -p "$snap_nm"
	for entry in "$repo_nm"/*; do
		[ -e "$entry" ] || continue
		base="${entry##*/}"
		if [ "$base" = "@bogo" ]; then
			mkdir -p "$snap_nm/@bogo"
			for ws in "$repo_nm/@bogo"/*; do
				wsname="${ws##*/}"
				ln -s "../../../$wsname" "$snap_nm/@bogo/$wsname"
			done
		else
			ln -s "$entry" "$snap_nm/$base"
		fi
	done
}

# Reattach external installs; keep workspace @bogo/* links inside the snapshot tree.
rm -rf "$snapshot/node_modules"
ln -s "$repo/node_modules" "$snapshot/node_modules"
for pkg_dir in "$repo/packages"/*; do
	[ -d "$pkg_dir" ] || continue
	wire_pkg_node_modules "${pkg_dir##*/}"
done
mkdir -p "$snapshot/.cache"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
export XDG_CACHE_HOME="$snapshot/.cache"
export XDG_STATE_HOME="$snapshot/.cache"
export TURBO_CACHE_DIR="$snapshot/.cache/turbo"
PATH="$snapshot/node_modules/.bin:$PATH"

cd "$snapshot" || exit 1

echo "━━━ snapshot_build (shared dist for workspace imports) ━━━"
if ! (
	cd packages/shared || exit 1
	bun run build
); then
	echo "❌ pre-commit: shared build failed" >&2
	exit 1
fi

TMPDIR_HOOK=$(mktemp -d -t bogo-precommit-XXXXXX)

run_bg() {
	local name="$1"
	shift
	( "$@" >"$TMPDIR_HOOK/$name.log" 2>&1; echo $? >"$TMPDIR_HOOK/$name.exit" ) &
	eval "PID_$name=\$!"
}

wait_stage() {
	local name="$1"
	local pid_var="PID_$name"
	local pid status
	pid=${!pid_var}
	wait "$pid" 2>/dev/null || true
	status=$(cat "$TMPDIR_HOOK/$name.exit" 2>/dev/null || echo 1)
	echo "━━━ $name (exit=$status) ━━━"
	cat "$TMPDIR_HOOK/$name.log"
	if [ "$status" -ne 0 ]; then
		echo "❌ pre-commit stage '$name' failed" >&2
		exit "$status"
	fi
}

run_bg typecheck bun turbo typecheck
run_bg biome_full bun run lint
run_bg routes bun run gate:routes
run_bg pages bun run gate:pages

wait_stage typecheck
wait_stage biome_full
wait_stage routes
wait_stage pages

echo "━━━ unit_cov ━━━"
if ! bash scripts/check-coverage.sh 90 95; then
	echo "❌ pre-commit stage 'unit_cov' failed" >&2
	exit 1
fi

echo "✔ pre-commit passed (L1 index snapshot)"
